<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.AIPlatform.V1" Version="2.24.0" />
    <PackageReference Include="Microsoft.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude test project sources from the web app compilation -->
    <Compile Remove="Wealthpix.Tests\**\*.cs" />
    <EmbeddedResource Remove="Wealthpix.Tests\**\*" />
    <None Remove="Wealthpix.Tests\**\*" />
  </ItemGroup>

</Project>
